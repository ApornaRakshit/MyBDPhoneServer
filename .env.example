NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=YOUR_DB_PASSWORD
DB_NAME=my_bd_phone_db
JWT_SECRET=CHANGE_ME

DGEPAY_ENV=uat
DGEPAY_BASE_URL=https://api-uat.dgepay.net/dipon/v3
DGEPAY_CLIENT_ID=YOUR_DGEPAY_CLIENT_ID
DGEPAY_CLIENT_SECRET=YOUR_DGEPAY_CLIENT_SECRET
# Optional. Leave empty unless DGePay supplied a separate AES secret.
# Otherwise the backend uses DGEPAY_CLIENT_SECRET.
DGEPAY_SECRET_KEY=
DGEPAY_CENTER_EMAIL=YOUR_MERCHANT_CENTER_EMAIL
DGEPAY_CENTER_PHONE=YOUR_MERCHANT_CENTER_PHONE
DGEPAY_API_KEY=YOUR_DGEPAY_API_KEY

DGEPAY_AUTH_PATH=/payment_gateway/authenticate
DGEPAY_INITIATE_PATH=/payment_gateway/initiate_payment
DGEPAY_VERIFY_PATH=/payment_gateway/check_transaction_status

# DGePay redirect/callback URL. This MUST be your backend endpoint, not the React page.
# In local development this is reached by the user browser; in production use a public HTTPS URL.
DGEPAY_REDIRECT_URL=http://localhost:5000/api/dgepay/callback

# Optional alias kept for older configs. The backend uses this when DGEPAY_REDIRECT_URL is left on the old React result URL.
DGEPAY_CALLBACK_URL=http://localhost:5000/api/dgepay/callback
DGEPAY_IPN_REDIRECT_URL=http://localhost:5000/api/dgepay/callback

# React result page after the backend verifies the payment
DGEPAY_FRONTEND_RESULT_URL=http://localhost:5173/payment/dgepay/result

DGEPAY_DEBUG=true
DGEPAY_TEST_MODE=true

# Authentication email testing
# Local development: set EMAIL_DEV_MODE=true to show one-time links in the UI when SMTP is not configured.
EMAIL_DEV_MODE=true
PASSWORD_RESET_DEV_MODE=true

# cPanel SMTP / production
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=MyBDPhone <noreply@mybdphone.com>
